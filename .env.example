# =============================================================================
# EduSmart Xiaozhi - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For production, ALL variables marked [REQUIRED] must be set.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# Set to "production" for production deployment
ENVIRONMENT=production

# ── Security Secrets [REQUIRED for production] ───────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=CHANGE_ME_GENERATE_RANDOM_STRING

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_STRING

# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=CHANGE_ME_GENERATE_FERNET_KEY

# ── Hugging Face [REQUIRED] ──────────────────────────────────────────────────
# Get token from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_token_here

# Dataset repo for storing data (format: username/repo-name)
HF_DATASET_REPO=username/repo-name

# ── Cookie Settings ──────────────────────────────────────────────────────────
# Set to "true" for HTTPS (production), "false" for HTTP (development)
COOKIE_SECURE=true

# ── Admin Account [RECOMMENDED FOR PRODUCTION] ───────────────────────────────
# Set custom admin credentials. If left unset and database is empty, a secure
# random password will be auto-generated upon initial startup.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Restored test account (optional, leave empty in production)
# RESTORED_USER_USERNAME=
# RESTORED_USER_PASSWORD=

# ── Allowed Hosts ────────────────────────────────────────────────────────────
# Comma-separated list of allowed hosts, or "*" for all
ALLOWED_HOSTS=*

# ── SSL/HTTPS Settings [REQUIRED for HTTPS] ─────────────────────────────────
# Path to SSL certificate and key files (inside container)
# SSL_CERT_PATH=/app/certs/fullchain.pem
# SSL_KEY_PATH=/app/certs/privkey.pem

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite database path (default: data/xiaozhi.db)
SQLITE_DB_PATH=data/xiaozhi.db

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ── Optional Settings ────────────────────────────────────────────────────────
# API Import Limits
# API_IMPORT_MAX_BYTES=5242880
# API_IMPORT_MAX_ITEMS=150
# API_IMPORT_TIMEOUT=12

# Chat History
# CHAT_HISTORY_MAX_TEXT_BYTES=1048576
# CHAT_HISTORY_DEFAULT_LIMIT=100

# MCP & Relay
# MCP_TOKEN_HASH_LENGTH=16
# REAL_RELAY_MAX_RELAYS=4
# REAL_RELAY_POLL_INTERVAL_MS=1000
# REAL_RELAY_DEVICE_ONLINE_SECONDS=45

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://xiaozhiscig.biz.id/api/auth/google/callback
